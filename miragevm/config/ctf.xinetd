service ctf
{
    disable = no
    socket_type = stream
    protocol    = tcp
    wait        = no
    user        = root
    type        = UNLISTED
    port        = 9999
    bind        = 0.0.0.0
    server      = /usr/sbin/chroot
    # This matches the ctf account explicitly created in the Dockerfile.
    # Do not change it without changing the Dockerfile chroot self-check too.
    server_args = --userspec=1001:1001 /home/ctf ./attachment
    banner_fail = /etc/banner_fail
    per_source  = 10
    rlimit_cpu  = 70
}
